    {
      "id": "IlDP3RrP88p5Cno9gmaiW",
      "type": "text",
      "x": -5426.216077387665,
      "y": -276.830997052775,
      "width": 611.7437744140625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
